# Server Port
SERVER_PORT=8085

# MongoDB Connection String
# Example Atlas: mongodb+srv://<db_username>:<db_password>@cluster0.pvbbqnv.mongodb.net/sis_db?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/sis_db
MONGO_URI=mongodb://localhost:27017/sis_db

# Upstash Cloud Redis REST Configuration
# Get from https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://<your-subdomain>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

# Redis Cache Connection (Local or Upstash Cloud over TLS)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Snowflake Unique ID Generator Node Allocation
SIS_SNOWFLAKE_DATACENTER_ID=1
SIS_SNOWFLAKE_WORKER_ID=1
